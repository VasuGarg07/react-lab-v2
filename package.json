{
  "name": "react-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "preview": "turbo preview",
    "dev:blogify": "pnpm --filter @react-lab/blogify dev",
    "dev:budget-buddy": "pnpm --filter @react-lab/budget-buddy dev",
    "dev:formlyst": "pnpm --filter @react-lab/formlyst dev",
    "dev:json-live": "pnpm --filter @react-lab/json-live dev",
    "dev:loan-wizard": "pnpm --filter @react-lab/loan-wizard dev",
    "dev:markdown-live": "pnpm --filter @react-lab/markdown-live dev",
    "dev:poke-memory": "pnpm --filter @react-lab/poke-memory dev",
    "dev:pokeverse": "pnpm --filter @react-lab/pokeverse dev",
    "dev:quizzo": "pnpm --filter @react-lab/quizzo dev",
    "dev:recipe-haven": "pnpm --filter @react-lab/recipe-haven dev",
    "dev:showcase": "pnpm --filter @react-lab/showcase dev",
    "dev:sorting-visualizer": "pnpm --filter @react-lab/sorting-visualizer dev",
    "dev:sudoku": "pnpm --filter @react-lab/sudoku dev",
    "dev:super-tic-tac-toe": "pnpm --filter @react-lab/super-tic-tac-toe dev",
    "build:blogify": "pnpm --filter @react-lab/blogify build",
    "build:budget-buddy": "pnpm --filter @react-lab/budget-buddy build",
    "build:formlyst": "pnpm --filter @react-lab/formlyst build",
    "build:json-live": "pnpm --filter @react-lab/json-live build",
    "build:loan-wizard": "pnpm --filter @react-lab/loan-wizard build",
    "build:markdown-live": "pnpm --filter @react-lab/markdown-live build",
    "build:poke-memory": "pnpm --filter @react-lab/poke-memory build",
    "build:pokeverse": "pnpm --filter @react-lab/pokeverse build",
    "build:quizzo": "pnpm --filter @react-lab/quizzo build",
    "build:recipe-haven": "pnpm --filter @react-lab/recipe-haven build",
    "build:showcase": "pnpm --filter @react-lab/showcase build",
    "build:sorting-visualizer": "pnpm --filter @react-lab/sorting-visualizer build",
    "build:sudoku": "pnpm --filter @react-lab/sudoku build",
    "build:super-tic-tac-toe": "pnpm --filter @react-lab/super-tic-tac-toe build",
    "deploy:showcase": "pnpm build:showcase && firebase deploy --only hosting:react-lab-v2",
    "deploy:blogify": "pnpm build:blogify && firebase deploy --only hosting:react-lab-blogify",
    "deploy:budget-buddy": "pnpm build:budget-buddy && firebase deploy --only hosting:react-lab-budget-buddy",
    "deploy:formlyst": "pnpm build:formlyst && firebase deploy --only hosting:react-lab-formlyst",
    "deploy:pokeverse": "pnpm build:pokeverse && firebase deploy --only hosting:react-lab-pokeverse",
    "deploy:recipe-haven": "pnpm build:recipe-haven && firebase deploy --only hosting:react-lab-recipe-haven",
    "deploy:quizzo": "pnpm build:quizzo && firebase deploy --only hosting:react-lab-quizzo",
    "deploy:poke-memory": "pnpm build:poke-memory && firebase deploy --only hosting:react-lab-poke-memory",
    "deploy:sudoku": "pnpm build:sudoku && firebase deploy --only hosting:react-lab-sudoku",
    "deploy:super-tic-tac-toe": "pnpm build:super-tic-tac-toe && firebase deploy --only hosting:react-lab-super-tic-tac-toe",
    "deploy:sorting-visualizer": "pnpm build:sorting-visualizer && firebase deploy --only hosting:react-lab-sorting-visualizer",
    "deploy:json-live": "pnpm build:json-live && firebase deploy --only hosting:react-lab-json",
    "deploy:markdown-live": "pnpm build:markdown-live && firebase deploy --only hosting:react-lab-markdown",
    "deploy:loan-wizard": "pnpm build:loan-wizard && firebase deploy --only hosting:react-lab-loan-wizard",
    "deploy:all": "turbo build && firebase deploy --only hosting"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "turbo": "^2.9.16",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
